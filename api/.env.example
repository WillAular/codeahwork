# ==========================================
# Configuración del Servidor API (Node 24 / NestJS)
# ==========================================
PORT=5003
NODE_ENV=production

# ==========================================
# Dominio Personalizado y CORS
# ==========================================
DOMAIN=api.codeah.com.ar
CORS_ORIGIN=https://codeah.com.ar,https://www.codeah.com.ar,http://localhost:3000

# ==========================================
# Base de Datos MySQL (Instancia independiente)
# - Si MySQL corre en la máquina host (local): usa 'host.docker.internal'
# - Si MySQL corre en un servidor/IP externo: usa la IP o hostname (ej: 192.168.1.10)
# ==========================================
DB_DIALECT=mysql
DB_HOST=host.docker.internal
DB_PORT=33066
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=codeah

# ==========================================
# Autenticación y Seguridad JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=1d

# ==========================================
# Credenciales Administrador Inicial
# ==========================================
INITIAL_ADMIN_EMAIL=admin@codeah.com
INITIAL_ADMIN_PASSWORD=password123

# ==========================================
# Notificaciones por Email (Gmail / SMTP)
# - Para Gmail: Activa verificación en 2 pasos y crea una "Contraseña de aplicación" en:
#   https://myaccount.google.com/apppasswords
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM="Codeah Software Studio" <codeahsistemas@gmail.com>
ENABLE_CLIENT_CONFIRMATION_EMAIL=true
CODEAH_WHATSAPP_NUMBER=+5491136490804
ADMIN_URL=https://codeah.com.ar

