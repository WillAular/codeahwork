# ==========================================
# Configuración del Servidor Web (Next.js / Node 24)
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# Dominio Personalizado
# ==========================================
DOMAIN=codeah.com.ar
NEXT_PUBLIC_APP_URL=https://codeah.com.ar

# ==========================================
# URL de la API Backend (NestJS)
# En producción, apunta al dominio de la API (ej: https://api.codeah.com.ar/api)
# Para pruebas locales con docker: http://localhost:5003/api
# ==========================================
NEXT_PUBLIC_API_URL=https://api.codeah.com.ar/api

# ==========================================
# Proveedores Externos (Opcional)
# ==========================================
RESEND_API_KEY=
